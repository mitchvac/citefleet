# ═══════════════════════════════════════════════════════════════════
# CiteFleet — production environment for citefleet.app
# Copy to .env:   cp deploy/.env.production.example .env
#
# Legend:
#   [SECRET]   = never commit, never share, rotate if exposed
#   [PUBLIC]   = safe to expose
#   [REQUIRED] = app will not boot/work correctly without it
#   [OPTIONAL] = feature degrades gracefully when empty
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=production                       # [PUBLIC]  [REQUIRED]
HOST=0.0.0.0                              # [PUBLIC]  [REQUIRED] listen inside the container
PORT=3000                                 # [PUBLIC]  [REQUIRED] container port (host binds 127.0.0.1:3021)
NITRO_HOST=0.0.0.0                        # [PUBLIC]  [REQUIRED]
NITRO_PORT=3000                           # [PUBLIC]  [REQUIRED]
VITE_AUTH_ENABLED=false                   # [PUBLIC]  [REQUIRED] no per-user accounts; the console uses the operator gate below

# Operator gate — one shared token, exchanged at /login for an httpOnly session
# cookie. Generated into /root/citefleet-operator.token by deploy/deploy-vps.sh.
# Without it every console action refuses (fail closed).
# CITEFLEET_OPERATOR_TOKEN=               # [SECRET]  [REQUIRED for the console] ops fallback on /login
# Invite-only accounts: only these emails may sign up / sign in (email, Google, GitHub).
# Empty = nobody (fail closed). deploy-vps.sh injects /root/citefleet-operator.emails.
# CITEFLEET_OPERATOR_EMAILS=              # [PUBLIC]  [REQUIRED for accounts]
# Google / GitHub OAuth apps (optional). Redirect URIs to register:
#   https://citefleet.app/api/oauth/google-callback   https://citefleet.app/api/oauth/github-callback
# deploy-vps.sh reads /root/citefleet-google.oauth and /root/citefleet-github.oauth (line 1 id, line 2 secret).
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / GITHUB_OAUTH_CLIENT_ID= / GITHUB_OAUTH_CLIENT_SECRET=

# ── Database ─────────────────────────────────────────────────────
# Optional. When set, the container can persist via Postgres/Neon.
# When empty, campaigns boot in-memory (lost on restart).
DATABASE_URL=                             # [SECRET]  [OPTIONAL] postgres://…

# BotCentral catalog — CiteFleet is the only publisher.
BOTCENTRAL_URL=https://botcentral.org     # [PUBLIC]  [REQUIRED]
# Shared with BotCentral via /root/citefleet-botcentral.token on the VPS.
# BOTCENTRAL_SERVICE_TOKEN=               # [SECRET]  [REQUIRED to list a site]
